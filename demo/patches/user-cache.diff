+# The user row, kept in process memory: served while fresh, and up to 5
+# minutes old when the database fails. A changed user shows up within 30s.
+_USER_FRESH_S = 30.0
+_USER_STALE_S = 300.0
+_users: dict[int, tuple[float, dict[str, Any]]] = {}
+
+
+async def _load_user(db: AsyncSession, user_id: int) -> dict[str, Any] | None:
+    cached = _users.get(user_id)
+    now = time.monotonic()
+    if cached and now - cached[0] < _USER_FRESH_S:
+        return cached[1]
+    try:
+        user = await crud_users.get(db=db, id=user_id, is_deleted=False)
+    except Exception:
+        if cached and now - cached[0] < _USER_STALE_S:
+            return cached[1]
+        raise
+    if user is not None:
+        _users[user_id] = (now, user)
+    else:
+        _users.pop(user_id, None)
+    return user
+
+
 async def get_current_user(
