# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory — OpenAI-compatible inference endpoint.
# Used for inference ONLY. The target system never runs on Nebius.
NEBIUS_API_KEY=your-token-factory-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily — live web search driving fault selection.
# Free tier: 1000 credits/month.
TAVILY_API_KEY=your-tavily-key-here

# Determinism. Every random decision in the loop seeds from this.
BEDLAM_SEED=1729

# Toxiproxy control API (Phase 1). Local only.
TOXIPROXY_URL=http://localhost:8474

# Target stack endpoints, as published by docker-compose.yml. The db and
# cache entries point at Toxiproxy's proxy ports, not the real backends --
# that is the path Bedlam's faults and probes both use.
BEDLAM_API_URL=http://localhost:8000
BEDLAM_DB_PROXY_HOST=localhost
BEDLAM_DB_PROXY_PORT=5433
BEDLAM_CACHE_PROXY_HOST=localhost
BEDLAM_CACHE_PROXY_PORT=6380
